<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeviceTimelineWindowsAgent</AssemblyName>
    <RootNamespace>AsashikiWindowsAgent</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Self-contained bundles the whole .NET runtime so users need nothing
         installed; that's the ~100MB, not junk. Compress the bundle to roughly
         halve it. (Not trimming: PublishTrimmed breaks WinForms reflection.) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Brand the tray/exe icon (generated from the shared app art). -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>
</Project>
