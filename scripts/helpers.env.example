# Non-secret environment for the optional host services. Supply real UUIDs for features you enable.
HIBI_DB_PATH=/srv/hibi/data/device-timeline.sqlite
HIBI_COLLECTOR_ORIGIN=http://127.0.0.1:4823
HIBI_CONSOLE_ORIGIN=https://hibi.example.org
HIBI_HEALTH_DEVICE_ID=android-phone
HIBI_MAC_DEVICE_ID=mac-laptop
HIBI_NOTION_DATA_SOURCE_ID=
HIBI_NOTION_DATABASE_ID=
HIBI_NOTION_PAGE_ID=
HIBI_NOTION_STATUS_BLOCK_ID=
HIBI_NOTION_PAIR_BLOCK_ID=
HIBI_NOTION_SLEEP_BLOCK_ID=
HIBI_SLEEP_START_HOUR=20
HIBI_SLEEP_END_HOUR=16
# Optional UTC/offset timestamp for marking legacy Mac idle observations.
# HIBI_MAC_LEGACY_IDLE_BEFORE=
