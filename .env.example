# ── Server ───────────────────────────────────────────────────────────────────
PORT=4200
HOST=0.0.0.0

# Where the SQLite file lives. In Docker this is a mounted volume so data and
# backups survive container rebuilds.
DB_PATH=./data/device-timeline.sqlite

# ── Device tokens ──────────────────────────────────────────────────────────────
# One entry per device. Each agent authenticates with its `token` (Bearer).
# Generate a token with:  openssl rand -hex 32
# `deviceId` is kebab-case and MUST be unique — this is how two devices of the
# same platform (e.g. an Android phone AND an Android tablet) are told apart.
# `platform` is one of: android | ios | windows | macos
DEVICE_TOKENS_JSON=[
  {"token":"REPLACE_WITH_RANDOM_HEX","deviceId":"android-phone","deviceName":"我的手机","platform":"android"},
  {"token":"REPLACE_WITH_RANDOM_HEX","deviceId":"android-tablet","deviceName":"我的平板","platform":"android"},
  {"token":"REPLACE_WITH_RANDOM_HEX","deviceId":"windows-pc","deviceName":"台式机","platform":"windows"},
  {"token":"REPLACE_WITH_RANDOM_HEX","deviceId":"mac-laptop","deviceName":"MacBook","platform":"macos"},
  {"token":"REPLACE_WITH_RANDOM_HEX","deviceId":"ios-phone","deviceName":"iPhone","platform":"ios"}
]

# Optionally point at a JSON file instead of inlining (takes precedence):
# DEVICE_TOKENS_FILE=./config/device-tokens.json

# ── Behavior tuning ────────────────────────────────────────────────────────────
# Gap (seconds) within which consecutive samples of the same app are merged into
# one activity row instead of creating a new one.
ACTIVITY_GRACE_SECONDS=120

# How many days of activity history to keep. The collector deletes
# device_activities older than this on startup and once a day. Default 60
# (~2 months). Set to 0 to disable auto-cleanup and keep everything forever.
RETENTION_DAYS=60

# Path to the app-label map. Mount this as a volume to edit friendly app names /
# status phrases WITHOUT rebuilding the image (the file is re-read on change).
LABELS_PATH=./config/app-labels.json

# Allow browser frontends (the console + your own status page) to fetch the
# read-only API. Comma-separated origins, or * for any.
CORS_ORIGIN=*

# ── Remote MCP endpoint (streamable HTTP at /mcp) ──────────────────────────────
# Lets web clients (claude.ai) connect over HTTPS. The collector serves it on the
# same port; put it behind your own HTTPS domain/proxy. claude.ai needs HTTPS.
MCP_HTTP_ENABLED=true
MCP_HTTP_PATH=/mcp
# If set, /mcp requires `Authorization: Bearer <this>`. Leave blank for no auth
# (only do that if the endpoint is otherwise protected / not publicly reachable).
MCP_HTTP_TOKEN=
