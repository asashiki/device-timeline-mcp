[Unit]
Description=Refresh the owner's fixed private Hibi state paragraph on demand
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/hibi/helpers.env
RuntimeDirectory=hibi-now
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LoadCredential=notion-token:/etc/hibi/notion-token
LoadCredential=context-read-token:/etc/hibi/context-read-token
LoadCredential=bridge-token:/etc/hibi/notion-now-bridge.token
ExecStart=/usr/bin/python3 -B /usr/local/lib/hibi/hibi_now_bridge.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
